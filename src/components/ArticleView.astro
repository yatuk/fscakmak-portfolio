---
import type { Locale } from '@ptypes/profile';
import HandRule from './HandRule.astro';
import NotebookFooter from './NotebookFooter.astro';
import '@styles/notebook.css';

export interface Props {
  locale: Locale;
  title: string;
  date: string;
  tags: string[];
  readingTime?: string;
}

const { locale, title, date, tags, readingTime } = Astro.props;
const tr = locale === 'tr';
const writingHref = `${tr ? '/tr' : ''}/writeups`;
---

<article class="nb">
  <a class="nb-back" href={writingHref}>← {tr ? 'yazdıklarım' : 'writing'}</a>

  <header>
    <div class="nb-post-meta">
      <span>{date}</span>
      {readingTime && <span>{readingTime}</span>}
      <span>{tags.join(' · ')}</span>
    </div>
    <h1 class="nb-art-title">{title}</h1>
  </header>

  <HandRule variant={0} />

  <div class="nb-prose">
    <slot />
  </div>

  <p class="nb-after">
    <a class="nb-back" href={writingHref}>← {tr ? 'tüm yazılar' : 'all writing'}</a>
  </p>

  <NotebookFooter locale={locale} />
</article>
