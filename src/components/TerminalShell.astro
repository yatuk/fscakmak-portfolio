---
import { getProfile } from '@lib/profile';
import { t } from '@core/i18n';
import type { Locale } from '@ptypes/profile';
import '@styles/terminal.css';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const profile = getProfile(locale);

const cvHref = locale === 'tr' ? '/tr/cv' : '/cv';
const recruiterLabel = t(locale, 'view.recruiter_label');
---

<div class="term-window" data-term-root data-locale={locale}>
  <div class="term-titlebar">
    <div class="term-dots" aria-hidden="true">
      <div class="term-dot term-dot-r"></div>
      <div class="term-dot term-dot-y"></div>
      <div class="term-dot term-dot-g"></div>
    </div>
    <div class="term-title" data-term-title>fscakmak@kali ~ % zsh</div>
    <div class="term-titlebar-right">
      <span class="term-score-label">{t(locale, 'terminal.score_label')}:</span>
      <span class="term-score-value" data-term-score-value>0/100</span>
      <span class="term-tbar-sep" aria-hidden="true"></span>
      <span class="term-lang-wrap">
        {locale === 'en' ? (
          <><span class="term-lang-active">EN</span><span class="term-lang-sep">/</span><a class="term-lang-alt" href="/tr/terminal" data-locale-link="tr">TR</a></>
        ) : (
          <><a class="term-lang-alt" href="/terminal" data-locale-link="en">EN</a><span class="term-lang-sep">/</span><span class="term-lang-active">TR</span></>
        )}
      </span>
      <span class="term-tbar-sep" aria-hidden="true"></span>
      <a class="term-view-toggle" href={cvHref} data-view-target="recruiter">
        {recruiterLabel} <span class="term-view-arrow" aria-hidden="true">→</span>
      </a>
    </div>
    <!-- Hidden score bar · kept for scoring module compatibility -->
    <div class="term-score-bar" aria-hidden="true" style="display:none">
      <div class="term-score-fill" data-term-score-fill style="width:0%"></div>
    </div>
  </div>

  <div class="term-body" data-term-body>
    <h1 class="term-logo">FSCAKMAK<span class="terminal-cursor" aria-hidden="true">_</span></h1>
    <div class="term-sub">{locale === 'tr' ? 'Güvenlik operasyonları. Açık kaynak. Biraz merak.' : 'Security operations. Open source. A little curiosity.'}</div>
    <p class="terminal-note">{locale === 'tr' ? 'Bu etkileşimli bir portfolyo simülasyonudur. Komut seç veya kendin yaz.' : 'An interactive portfolio simulation. Choose a command or type your own.'}</p>
    <div class="term-nav">
      <span class="term-nav-arrow">→</span>
      {t(locale, 'terminal.nav_prefix')}
      <button type="button" data-term-quick="help">help</button>
      {t(locale, 'terminal.nav_suffix')}
    </div>

    <div
      class="term-output"
      data-term-output
      role="log"
      aria-live="polite"
      aria-label={t(locale, 'terminal.output_aria')}
    ></div>

    <div class="term-input-line">
      <span class="term-prompt" aria-hidden="true">$ </span>
      <input
        type="text"
        class="term-input"
        data-term-input
        autocomplete="off"
        spellcheck="false"
        aria-label={t(locale, 'terminal.input_aria')}
      />
    </div>
    <div class="term-suggestions" data-term-suggestions role="group" aria-label="suggestions"></div>
    <div class="term-hint">{t(locale, 'terminal.hint')}</div>

    <nav class="term-mobile-chips" aria-label={t(locale, 'terminal.chips_aria')}>
      <button type="button" class="term-chip" data-term-quick="whoami">whoami</button>
      <button type="button" class="term-chip" data-term-quick="projects">projects</button>
      <button type="button" class="term-chip" data-term-quick="experience">experience</button>
      <button type="button" class="term-chip" data-term-quick="scan">scan</button>
      <button type="button" class="term-chip" data-term-quick="contact">contact</button>
      <button type="button" class="term-chip" data-term-quick="help">help</button>
    </nav>
  </div>

  <div class="term-footer">{t(locale, 'terminal.footer')}</div>
</div>

<script
  type="application/json"
  data-term-state
  is:inline
  set:html={JSON.stringify({ profile, locale })}
/>

<script>
  import { initTerminal } from '@core/terminal';
  import { scrambleReveal } from '@lib/motion';
  import type { Locale, Profile } from '@ptypes/profile';

  scrambleReveal(document.querySelector('[data-term-title]'));

  const root = document.querySelector<HTMLElement>('[data-term-root]');
  const stateEl = document.querySelector<HTMLElement>('[data-term-state]');
  if (root && stateEl?.textContent) {
    const state = JSON.parse(stateEl.textContent) as {
      profile: Profile;
      locale: Locale;
    };
    document.body.classList.add('terminal-body');
    initTerminal({ container: root, profile: state.profile, locale: state.locale });
  }
</script>
