---
import { getProfile } from '@lib/profile';
import { t } from '@core/i18n';
import type { Locale } from '@ptypes/profile';
import '@styles/terminal.css';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const profile = getProfile(locale);
---

<!-- Entry screen — shown on every page load, no persistence.
     User picks a view; TERMINAL gates the boot sequence. -->
<div class="entry-screen" data-entry-screen>
  <div class="entry-content">
    <div class="entry-name" data-entry-name></div>
    <div class="entry-sep" aria-hidden="true"></div>
    <div class="entry-buttons">
      <button type="button" class="entry-btn entry-btn-terminal" data-entry-terminal>
        <span class="entry-btn-label">TERMINAL</span>
        <span class="entry-btn-hint" aria-hidden="true">&gt; access_shell</span>
      </button>
      <button type="button" class="entry-btn entry-btn-recruiter" data-entry-recruiter>
        <span class="entry-btn-label">RECRUITER VIEW</span>
        <span class="entry-btn-hint" aria-hidden="true">&gt; load_report</span>
      </button>
    </div>
  </div>

  <div class="entry-status" data-entry-status aria-hidden="true">
    <span class="entry-status-item entry-status-online">● STATUS: ONLINE</span>
    <span class="entry-status-item">PROTOCOL: HTTPS</span>
    <span class="entry-status-item">CONNECTION: SECURE</span>
  </div>
</div>

<!-- Boot overlay — shown after terminal is chosen, first-visit-only per session. -->
<div class="boot-overlay" data-boot-overlay aria-hidden="true">
  <div class="boot-content" data-boot-lines></div>
  <button
    type="button"
    class="boot-skip"
    data-boot-skip
    aria-label={t(locale, 'terminal.boot_skip_aria')}
  >
    {t(locale, 'terminal.boot_skip')} ⏵
  </button>
</div>

<div class="term-window" data-term-root data-locale={locale}>
  <div class="term-titlebar">
    <div class="term-dots" aria-hidden="true">
      <div class="term-dot term-dot-r"></div>
      <div class="term-dot term-dot-y"></div>
      <div class="term-dot term-dot-g"></div>
    </div>
    <div class="term-title">fscakmak@kali ~ % zsh</div>
    <div class="term-score">
      <span class="term-score-label">{t(locale, 'terminal.score_label')}:</span>
      <div class="term-score-bar" aria-hidden="true">
        <div class="term-score-fill" data-term-score-fill style="width:0%"></div>
      </div>
      <span class="term-score-value" data-term-score-value>0/100</span>
    </div>
  </div>

  <div class="term-body" data-term-body>
    <div class="term-logo">FSCAKMAK</div>
    <div class="term-sub">{t(locale, 'terminal.logo_sub')}</div>
    <div class="term-nav">
      <span class="term-nav-arrow">→</span>
      {t(locale, 'terminal.nav_prefix')}
      <button type="button" data-term-quick="help">help</button>
      {t(locale, 'terminal.nav_suffix')}
    </div>

    <div
      class="term-output"
      data-term-output
      role="log"
      aria-live="polite"
      aria-label={t(locale, 'terminal.output_aria')}
    ></div>

    <div class="term-input-line">
      <span class="term-prompt" aria-hidden="true">$ </span>
      <input
        type="text"
        class="term-input"
        data-term-input
        autocomplete="off"
        spellcheck="false"
        autofocus
        aria-label={t(locale, 'terminal.input_aria')}
      />
    </div>
    <div class="term-suggestions" data-term-suggestions role="listbox" aria-label="suggestions"></div>
    <div class="term-hint">{t(locale, 'terminal.hint')}</div>

    <nav class="term-mobile-chips" aria-label={t(locale, 'terminal.chips_aria')}>
      <button type="button" class="term-chip" data-term-quick="whoami">whoami</button>
      <button type="button" class="term-chip" data-term-quick="projects">projects</button>
      <button type="button" class="term-chip" data-term-quick="contact">contact</button>
      <button type="button" class="term-chip" data-term-quick="help">help</button>
    </nav>
  </div>

  <div class="term-footer">{t(locale, 'terminal.footer')}</div>
</div>

<script
  type="application/json"
  data-term-state
  is:inline
  set:html={JSON.stringify({ profile, locale })}
/>

<script is:inline>
  (() => {
    const screen = document.querySelector('[data-entry-screen]');
    if (!screen) return;

    const reduced = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;

    /* Bypass: returning from recruiter view via the view toggle. */
    let bypass = false;
    try {
      bypass = sessionStorage.getItem('fsc.entry.bypass') === '1';
      if (bypass) sessionStorage.removeItem('fsc.entry.bypass');
    } catch {}

    if (bypass) {
      screen.remove();
      window.__entryChoice = 'terminal';
      window.dispatchEvent(new CustomEvent('fsc:terminal-chosen'));
      return;
    }

    const locale  = document.documentElement.lang;
    const cvPath  = locale === 'tr' ? '/tr/cv' : '/cv';
    const nameEl  = screen.querySelector('[data-entry-name]');
    const sepEl   = screen.querySelector('.entry-sep');
    const btns    = screen.querySelectorAll('.entry-btn');
    const statusEl = screen.querySelector('[data-entry-status]');
    const NAME    = 'FSCAKMAK';
    const CHAR_MS = 55;
    /* CRT power-on takes ~420ms — start typing shortly after it peaks */
    const START   = reduced ? 0 : 360;

    /* Reveal separator + buttons after name is done */
    const revealBelow = () => {
      if (sepEl) sepEl.classList.add('sep-draw');
      btns.forEach((btn, i) => {
        window.setTimeout(() => btn.classList.add('btn-reveal'), 60 + i * 140);
      });
      if (statusEl) {
        window.setTimeout(
          () => statusEl.classList.add('status-reveal'),
          reduced ? 0 : 420
        );
      }
    };

    if (nameEl) {
      if (reduced) {
        nameEl.textContent = NAME;
        nameEl.classList.add('entry-name-done');
        revealBelow();
      } else {
        let i = 0;
        const tick = () => {
          if (i < NAME.length) {
            nameEl.textContent = NAME.slice(0, ++i);
            window.setTimeout(tick, CHAR_MS);
          } else {
            /* Hold cursor for one extra blink cycle, then dismiss it */
            window.setTimeout(() => {
              nameEl.classList.add('entry-name-done');
              revealBelow();
            }, 320);
          }
        };
        window.setTimeout(tick, START);
      }
    }

    /* Dismiss — mode 'terminal' zooms into the terminal behind the screen.
       Mode 'recruiter' slides the screen upward toward the new page. */
    const dismiss = (mode, then) => {
      btns.forEach((b) => b.classList.add('btn-chosen'));
      window.setTimeout(() => {
        screen.classList.add('exit-' + mode);
        const dur = mode === 'terminal' ? 320 : 260;
        window.setTimeout(() => { screen.remove(); if (then) then(); }, dur);
      }, 90);
    };

    screen.querySelector('[data-entry-terminal]')?.addEventListener('click', () => {
      dismiss('terminal', () => {
        window.__entryChoice = 'terminal';
        window.dispatchEvent(new CustomEvent('fsc:terminal-chosen'));
      });
    });

    screen.querySelector('[data-entry-recruiter]')?.addEventListener('click', () => {
      dismiss('recruiter', () => { window.location.href = cvPath; });
    });
  })();
</script>

<script is:inline>
  /* Boot overlay — character-by-character typing, gated on terminal choice.
     Only starts after 'fsc:terminal-chosen' fires from the entry screen. */
  (() => {
    const overlay = document.querySelector('[data-boot-overlay]');
    if (!overlay) return;

    const reduced = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;
    let seen = false;
    try { seen = sessionStorage.getItem('fsc.boot.seen') === '1'; } catch {}

    const runBoot = () => {
      if (reduced || seen) { overlay.remove(); return; }
      try { sessionStorage.setItem('fsc.boot.seen', '1'); } catch {}

      const container = overlay.querySelector('[data-boot-lines]');
      if (!container) return;

      const LINES = [
        { text: '> initializing fscakmak.com...', suffix: null,                                         lineCls: null,           pause: 150 },
        { text: '> loading security context...    ', suffix: { cls: 'boot-bar',      str: '████████░░  80%' }, lineCls: null,           pause: 200 },
        { text: '> mounting profile data...       ', suffix: { cls: 'boot-bar-done', str: '██████████ 100%' }, lineCls: null,           pause: 150 },
        { text: '> establishing encrypted session ', suffix: { cls: 'boot-ok',       str: '[OK]' },      lineCls: null,           pause: 100 },
        { text: '> threat intel feeds...          ', suffix: { cls: 'boot-ok',       str: '[OK]' },      lineCls: null,           pause: 200 },
        { text: '> welcome, analyst.',              suffix: null,                                         lineCls: 'boot-welcome', pause: 300 },
      ];

      const CHAR_MS = 15;
      let dismissed = false;

      const dismiss = () => {
        if (dismissed) return;
        dismissed = true;
        overlay.classList.add('boot-fade');
        window.setTimeout(() => overlay.remove(), 320);
      };

      const typeLine = (cfg, onDone) => {
        const div = document.createElement('div');
        div.className = 'boot-line' + (cfg.lineCls ? ' ' + cfg.lineCls : '');
        container.appendChild(div);

        let i = 0;
        const tick = () => {
          if (dismissed) return;
          if (i < cfg.text.length) {
            div.appendChild(document.createTextNode(cfg.text[i++]));
            window.setTimeout(tick, CHAR_MS);
          } else {
            if (cfg.suffix) {
              const span = document.createElement('span');
              span.className = cfg.suffix.cls;
              span.textContent = cfg.suffix.str;
              div.appendChild(span);
            }
            window.setTimeout(onDone, cfg.pause);
          }
        };
        tick();
      };

      const run = (idx) => {
        if (dismissed) return;
        if (idx >= LINES.length) { dismiss(); return; }
        typeLine(LINES[idx], () => run(idx + 1));
      };

      window.setTimeout(() => run(0), 200);
      overlay.querySelector('[data-boot-skip]')?.addEventListener('click', dismiss);
    };

    /* Gate: wait for the entry screen to signal terminal choice. */
    if (window.__entryChoice === 'terminal') {
      runBoot();
    } else {
      window.addEventListener('fsc:terminal-chosen', runBoot, { once: true });
    }
  })();
</script>

<script is:inline>
  /* Logo glitch — character corruption every 3-8s, reduced-motion aware. */
  (() => {
    if (window.matchMedia?.('(prefers-reduced-motion: reduce)').matches) return;

    const fire = () => {
      const logo = document.querySelector('.term-logo');
      if (!logo || !document.body.contains(logo)) return;

      const original = logo.textContent ?? '';
      const CHARS = '!@#%^&*<>?/|[]{}ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
      const txt = original.split('');

      /* Corrupt 1-2 random characters */
      const count = 1 + Math.floor(Math.random() * 2);
      for (let c = 0; c < count; c++) {
        const idx = Math.floor(Math.random() * txt.length);
        txt[idx] = CHARS[Math.floor(Math.random() * CHARS.length)];
      }
      logo.textContent = txt.join('');

      /* Restore after 60-120ms */
      window.setTimeout(() => {
        const l = document.querySelector('.term-logo');
        if (l) l.textContent = original;
      }, 60 + Math.random() * 60);

      /* Schedule next glitch */
      window.setTimeout(fire, 3000 + Math.random() * 5000);
    };

    /* First glitch after terminal is settled */
    window.setTimeout(fire, 4000 + Math.random() * 2000);
  })();
</script>

<script>
  import { initTerminal } from '@core/terminal';
  import type { Locale, Profile } from '@ptypes/profile';

  const root = document.querySelector<HTMLElement>('[data-term-root]');
  const stateEl = document.querySelector<HTMLElement>('[data-term-state]');
  if (root && stateEl?.textContent) {
    const state = JSON.parse(stateEl.textContent) as {
      profile: Profile;
      locale: Locale;
    };
    initTerminal({ container: root, profile: state.profile, locale: state.locale });
  }
</script>
