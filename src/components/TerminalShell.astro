---
import { getProfile } from '@lib/profile';
import { t } from '@core/i18n';
import type { Locale } from '@ptypes/profile';
import '@styles/terminal.css';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const profile = getProfile(locale);
---

<!-- Boot overlay — shown on first visit per session, dismissible.
     Rendered server-side so it appears instantly without waiting
     for the terminal bundle. -->
<div class="boot-overlay" data-boot-overlay aria-hidden="true">
  <div class="boot-content">
    <div class="boot-line" data-boot-delay="0">[ 0.000000] Booting fscakmak.com v2.0.0</div>
    <div class="boot-line" data-boot-delay="450">[ 0.124301] Loading kernel modules... <span class="boot-ok">OK</span></div>
    <div class="boot-line" data-boot-delay="850">[ 0.341209] Initializing SIEM... <span class="boot-ok">OK</span></div>
    <div class="boot-line" data-boot-delay="1300">[ 0.502318] Mounting /home/fscakmak... <span class="boot-ok">OK</span></div>
    <div class="boot-line" data-boot-delay="1800">[ 0.731450] Starting zsh shell... <span class="boot-ok">OK</span></div>
    <div class="boot-line boot-welcome" data-boot-delay="2300">[ 0.892101] Welcome, fscakmak@kali</div>
  </div>
  <button
    type="button"
    class="boot-skip"
    data-boot-skip
    aria-label={t(locale, 'terminal.boot_skip_aria')}
  >
    {t(locale, 'terminal.boot_skip')} ⏵
  </button>
</div>

<div class="term-window" data-term-root data-locale={locale}>
  <div class="term-titlebar">
    <div class="term-dots" aria-hidden="true">
      <div class="term-dot term-dot-r"></div>
      <div class="term-dot term-dot-y"></div>
      <div class="term-dot term-dot-g"></div>
    </div>
    <div class="term-title">fsc@kali ~ % zsh</div>
    <div class="term-score">
      <span class="term-score-label">{t(locale, 'terminal.score_label')}:</span>
      <div class="term-score-bar" aria-hidden="true">
        <div class="term-score-fill" data-term-score-fill style="width:0%"></div>
      </div>
      <span class="term-score-value" data-term-score-value>0/100</span>
    </div>
  </div>

  <div class="term-body" data-term-body>
    <div class="term-logo">FSCAKMAK</div>
    <div class="term-sub">{t(locale, 'terminal.logo_sub')}</div>
    <div class="term-nav">
      <span class="term-nav-arrow">→</span>
      {t(locale, 'terminal.nav_prefix')}
      <button type="button" data-term-quick="help">help</button>
      {t(locale, 'terminal.nav_suffix')}
    </div>

    <div
      class="term-output"
      data-term-output
      role="log"
      aria-live="polite"
      aria-label={t(locale, 'terminal.output_aria')}
    ></div>

    <div class="term-input-line">
      <span class="term-prompt" aria-hidden="true">$ </span>
      <input
        type="text"
        class="term-input"
        data-term-input
        autocomplete="off"
        spellcheck="false"
        autofocus
        aria-label={t(locale, 'terminal.input_aria')}
      />
    </div>
    <div class="term-hint">{t(locale, 'terminal.hint')}</div>
  </div>

  <div class="term-footer">{t(locale, 'terminal.footer')}</div>
</div>

<script
  type="application/json"
  data-term-state
  is:inline
  set:html={JSON.stringify({ profile, locale })}
/>

<script is:inline>
  /* Boot overlay driver — first-visit-only per session, with
     skip button and prefers-reduced-motion respect.

     Why inline + is:inline: needs to run before the terminal
     bundle parses, so the overlay either fades in immediately
     or removes itself before paint. */
  (() => {
    const overlay = document.querySelector('[data-boot-overlay]');
    if (!overlay) return;

    const reduced =
      window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;
    let seen = false;
    try {
      seen = sessionStorage.getItem('fsc.boot.seen') === '1';
    } catch {
      /* session storage unavailable — treat as not-seen */
    }

    if (reduced || seen) {
      overlay.remove();
      return;
    }

    try {
      sessionStorage.setItem('fsc.boot.seen', '1');
    } catch {
      /* no-op */
    }

    overlay.classList.add('boot-on');
    overlay.querySelectorAll('[data-boot-delay]').forEach((el) => {
      const delay = parseInt(el.getAttribute('data-boot-delay') || '0', 10);
      window.setTimeout(() => el.classList.add('boot-visible'), delay);
    });

    const dismiss = () => {
      overlay.classList.add('boot-fade');
      window.setTimeout(() => overlay.remove(), 600);
    };

    /* Auto-dismiss 2.8s in, leaving 0.6s for the fade-out. */
    const autoTimer = window.setTimeout(dismiss, 2800);

    overlay.querySelector('[data-boot-skip]')?.addEventListener('click', () => {
      window.clearTimeout(autoTimer);
      dismiss();
    });
  })();
</script>

<script>
  import { initTerminal } from '@core/terminal';
  import type { Locale, Profile } from '@ptypes/profile';

  const root = document.querySelector<HTMLElement>('[data-term-root]');
  const stateEl = document.querySelector<HTMLElement>('[data-term-state]');
  if (root && stateEl?.textContent) {
    const state = JSON.parse(stateEl.textContent) as {
      profile: Profile;
      locale: Locale;
    };
    initTerminal({ container: root, profile: state.profile, locale: state.locale });

    // "help" quick-launch link in the nav
    document.querySelectorAll<HTMLButtonElement>('[data-term-quick]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const input = root.querySelector<HTMLInputElement>('[data-term-input]');
        const cmd = btn.dataset.termQuick ?? 'help';
        if (input) {
          input.value = cmd;
          input.dispatchEvent(new KeyboardEvent('keydown', { key: 'Enter' }));
          input.focus();
        }
      });
    });
  }
</script>
