---
import { getProfile } from '@lib/profile';
import { t } from '@core/i18n';
import type { Locale } from '@ptypes/profile';
import '@styles/recruiter.css';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const profile = getProfile(locale);
const { identity, about, skills, experience, education, projects, certifications } = profile;

/* Metrics — calculated, never hardcoded.
   monthsInSoc: full calendar months from 2025-07 (Doğuş start) to now. */
const SOC_START = new Date('2025-07-01T00:00:00Z');
const now = new Date();
const monthsInSoc = Math.max(
  0,
  (now.getUTCFullYear() - SOC_START.getUTCFullYear()) * 12 +
    (now.getUTCMonth() - SOC_START.getUTCMonth())
);
const featured = projects.filter((p) => p.featured);

const present = t(locale, 'cmd.experience.present');
const partTime = t(locale, 'cmd.experience.part_time');
const expected = t(locale, 'cmd.education.expected');

const localePrefix = locale === 'tr' ? '/tr' : '';
const terminalHref = localePrefix || '/';

/* Plurals — Turkish doesn't differentiate singular/plural the same
   way English does, but we keep parity by routing through the same
   strings (TR singular === TR plural in our JSON). */
const pluralize = (n: number, plural: string, singular: string) =>
  n === 1 ? singular : plural;
const monthsLabel = pluralize(
  monthsInSoc,
  t(locale, 'recruiter.metrics_months'),
  t(locale, 'recruiter.metrics_months_singular')
);
const projectsLabel = pluralize(
  featured.length,
  t(locale, 'recruiter.metrics_projects'),
  t(locale, 'recruiter.metrics_projects_singular')
);
const certsLabel = pluralize(
  certifications.length,
  t(locale, 'recruiter.metrics_certs'),
  t(locale, 'recruiter.metrics_certs_singular')
);
---

<article class="cv-root" id="cv">
  <!-- ── HERO ─────────────────────────────────────────── -->
  <header class="cv-card cv-hero">
    <h1 class="cv-hero-name">{identity.name}</h1>
    {identity.tagline && (
      <p class="cv-hero-tagline">{identity.tagline}</p>
    )}
    <p class="cv-hero-role">
      {identity.role} <span class="at">@</span> {experience[0]?.company ?? 'Fibabanka'}
    </p>
    <p class="cv-hero-meta">
      {identity.location}
      <span class="dot" aria-hidden="true">·</span>
      {identity.sector}
    </p>
    <p class="cv-hero-pitch">{identity.current}</p>
    <div class="cv-cta-row">
      <a class="cv-cta cv-cta-primary" href={`mailto:${identity.email}`}>
        📧 {t(locale, 'recruiter.cta_email')}
      </a>
      <a
        class="cv-cta"
        href={`https://linkedin.com/in/${identity.social.linkedin}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        💼 {t(locale, 'recruiter.cta_linkedin')}
      </a>
      <a
        class="cv-cta"
        href={`https://github.com/${identity.social.github}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        🐙 {t(locale, 'recruiter.cta_github')}
      </a>
      <a class="cv-cta" href="/resume.pdf" download>
        📄 {t(locale, 'recruiter.cta_download_cv')}
      </a>
    </div>
  </header>

  <!-- ── METRICS ──────────────────────────────────────── -->
  <section class="cv-metrics" aria-label="metrics">
    <div class="cv-card cv-metric">
      <div class="cv-metric-value">{monthsInSoc}</div>
      <div class="cv-metric-label">{monthsLabel}</div>
    </div>
    <div class="cv-card cv-metric">
      <div class="cv-metric-value">{featured.length}</div>
      <div class="cv-metric-label">{projectsLabel}</div>
    </div>
    <div class="cv-card cv-metric">
      <div class="cv-metric-value">{certifications.length}</div>
      <div class="cv-metric-label">{certsLabel}</div>
    </div>
  </section>

  <!-- ── ABOUT + SKILLS ───────────────────────────────── -->
  <section class="cv-row">
    <div class="cv-card">
      <h2 class="cv-card-title">{t(locale, 'sections.about')}</h2>
      <p class="cv-about-text">{about}</p>
    </div>
    <div class="cv-card">
      <h2 class="cv-card-title">{t(locale, 'sections.skills')}</h2>
      <div class="cv-skill-group">
        <div class="cv-skill-label">{t(locale, 'skill_groups.cybersecurity')}</div>
        <div class="cv-skill-chips">
          {skills.cybersecurity.map((s) => <span class="cv-chip cv-chip-emph">{s}</span>)}
        </div>
      </div>
      <div class="cv-skill-group">
        <div class="cv-skill-label">{t(locale, 'skill_groups.infrastructure')}</div>
        <div class="cv-skill-chips">
          {skills.infrastructure.map((s) => <span class="cv-chip">{s}</span>)}
        </div>
      </div>
      <div class="cv-skill-group">
        <div class="cv-skill-label">{t(locale, 'skill_groups.compliance')}</div>
        <div class="cv-skill-chips">
          {skills.compliance.map((s) => <span class="cv-chip">{s}</span>)}
        </div>
      </div>
      <div class="cv-skill-group">
        <div class="cv-skill-label">{t(locale, 'skill_groups.tools')}</div>
        <div class="cv-skill-chips">
          {skills.tools.map((s) => <span class="cv-chip">{s}</span>)}
        </div>
      </div>
      <div class="cv-spoken">
        {skills.spoken_languages.map((l) => (
          <div class="cv-spoken-row">
            <span class="cv-spoken-name">{l.name}</span>
            <span class="cv-spoken-level">— {l.level}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── EXPERIENCE + EDUCATION ───────────────────────── -->
  <section class="cv-row">
    <div class="cv-card">
      <h2 class="cv-card-title">{t(locale, 'sections.experience')}</h2>
      <div class="cv-exp-list">
        {experience.map((e) => (
          <div class={`cv-exp${e.active ? ' cv-exp-active' : ''}`}>
            <div class="cv-exp-meta">
              {e.active && (
                <span class="cv-exp-pill cv-exp-pill-active">● {t(locale, 'cmd.experience.active')}</span>
              )}
              {e.part_time && (
                <span class="cv-exp-pill cv-exp-pill-pt">{partTime}</span>
              )}
              <span class="cv-exp-date">{e.start} – {e.end ?? present}</span>
            </div>
            <div class="cv-exp-title">
              {e.title} — <span class="cv-exp-company">{e.company}</span>
            </div>
            <div class="cv-exp-location">{e.location}</div>
            <ul class="cv-exp-bullets">
              {e.highlights.map((h) => <li>{h}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="cv-card">
      <h2 class="cv-card-title">{t(locale, 'sections.education')}</h2>
      <div class="cv-edu-list">
        {education.map((edu) => (
          <div>
            <div class="cv-edu-degree">{edu.degree}</div>
            <div class="cv-edu-school">{edu.school}</div>
            <div class="cv-edu-date">
              {edu.start} – {edu.end}{edu.expected ? ` (${expected})` : ''}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FEATURED PROJECTS ────────────────────────────── -->
  <section class="cv-card">
    <h2 class="cv-card-title">{t(locale, 'recruiter.section_featured')}</h2>
    <div class="cv-projects">
      {featured.map((p) => (
        <article class="cv-project">
          <div class="cv-project-head">
            <a
              class="cv-project-name"
              href={p.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {p.name} ↗
            </a>
            <span class={`cv-project-pill cv-project-pill-${p.owner_type}`}>
              {p.owner_type === 'team'
                ? t(locale, 'project.owner_team')
                : t(locale, 'project.owner_personal')}
            </span>
          </div>
          <div class="cv-project-tags">
            {p.tags.map((tg) => <span class="cv-project-tag">{tg}</span>)}
          </div>
          <p class="cv-project-summary">{p.summary}</p>
          {p.owner_note && <div class="cv-project-note">{p.owner_note}</div>}
        </article>
      ))}
    </div>
  </section>

  <!-- ── CERTIFICATIONS ───────────────────────────────── -->
  <section class="cv-card">
    <h2 class="cv-card-title">{t(locale, 'sections.certifications')}</h2>
    <div class="cv-certs">
      {certifications.map((c) => (
        <div class="cv-cert">
          <div class="cv-cert-badge" aria-hidden="true">🎖️</div>
          <div>
            <div class="cv-cert-name">{c.name}</div>
            {c.full_name && <div class="cv-cert-full">{c.full_name}</div>}
            <div class="cv-cert-issuer">{c.issuer}{c.date ? ` · ${c.date}` : ''}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── CONTACT ──────────────────────────────────────── -->
  <section class="cv-card cv-contact">
    <h2 class="cv-contact-title">{t(locale, 'recruiter.section_contact')}</h2>
    <div class="cv-contact-row">
      <a class="cv-cta cv-cta-primary" href={`mailto:${identity.email}`}>
        📧 {identity.email}
      </a>
      <a
        class="cv-cta"
        href={`https://linkedin.com/in/${identity.social.linkedin}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        💼 linkedin.com/in/{identity.social.linkedin}
      </a>
      <a
        class="cv-cta"
        href={`https://github.com/${identity.social.github}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        🐙 github.com/{identity.social.github}
      </a>
    </div>
  </section>

  <!-- ── Mobile force-terminal escape hatch ──────────── -->
  <p class="cv-force-terminal">
    <a href={terminalHref} data-force-terminal>
      ⌨ {t(locale, 'recruiter.force_terminal_label')}
    </a>
    <br />
    <span style="opacity:.7">{t(locale, 'recruiter.force_terminal_hint')}</span>
  </p>

  <footer class="cv-footer">{t(locale, 'recruiter.footer_note')}</footer>
</article>

<script is:inline>
  /* Tag <body> so the recruiter-specific layout rules apply, and
     remember an explicit "force terminal" click so the auto-switch
     on terminal pages doesn't bounce mobile users back here. */
  document.body.classList.add('cv-body');
  const force = document.querySelector('[data-force-terminal]');
  if (force) {
    force.addEventListener('click', () => {
      try {
        localStorage.setItem('fsc.view', 'terminal');
      } catch {
        /* private mode — no-op */
      }
    });
  }
</script>
