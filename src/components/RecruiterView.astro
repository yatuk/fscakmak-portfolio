---
import { getProfile } from '@lib/profile';
import { t } from '@core/i18n';
import type { Locale } from '@ptypes/profile';
import LanguageToggle from './LanguageToggle.astro';
import writeups from '@data/writeups.json';
import '@styles/fonts-body.css';
import '@styles/recruiter.css';
export interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = locale === 'tr';
const prefix = tr ? '/tr' : '';
const { identity, about, skills, experience, education, projects, certifications } = getProfile(locale);
const short = (name: string) => name.split(' · ')[0].split(' · ')[0].split(':')[0];
---
<div class="portfolio">
  <nav class="portfolio-nav" aria-label={tr ? 'Ana menü' : 'Main navigation'}>
    <a class="wordmark" href={prefix || '/'} aria-label={identity.name}>fsc<span>.</span></a>
    <div class="nav-sections">
      <a href="#work">{tr ? 'Projeler' : 'Work'}</a>
      <a href="#experience">{tr ? 'Deneyim' : 'Experience'}</a>
      <a href={`${prefix}/writeups`}>{tr ? 'Yazılar' : 'Writing'}</a>
    </div>
    <div class="nav-tools"><LanguageToggle locale={locale} /><a class="terminal-link" href={`${prefix}/terminal`}><span aria-hidden="true">&gt;_</span> Terminal</a></div>
  </nav>
  <article class="cv-root" id="cv">
    <header class="profile-hero">
      <div class="hero-main">
        <h1 data-reveal-hero>Fatih Serdar<br /><span>Çakmak.</span></h1>
        <p class="hero-statement" data-reveal-hero>{tr ? 'Gündüz mavi takım.' : 'Blue team by day.'}<br />{tr ? 'Gece daha güvenli AI.' : 'Safer AI by night.'}</p>
        <p class="hero-intro" data-reveal-hero>{tr ? 'Fibabanka’da SOC analist stajyeri. İTÜ’de bilgisayar mühendisliği öğrencisi. Tehditleri araştırıyor, güvenlik araçları geliştiriyorum.' : 'SOC analyst intern at Fibabanka. Computer Engineering student at ITU. Investigating threats and building tools to keep systems safe.'}</p>
        <div class="hero-actions" data-reveal-hero><a class="button primary" href="#work">{tr ? 'Projeleri keşfet' : 'Explore my work'} <span aria-hidden="true">↗</span></a><a class="text-link" href="/resume.pdf" download>{tr ? 'CV indir' : 'Download CV'} <span aria-hidden="true">↓</span></a></div>
      </div>
      <aside class="hero-aside" aria-label={tr ? 'Çalışma alanları' : 'Areas of work'} data-reveal-hero>
        <div class="security-map" aria-hidden="true">
          <svg viewBox="0 0 400 320" fill="none"><path class="map-grid" d="M0 80H400M0 160H400M0 240H400M80 0V320M160 0V320M240 0V320M320 0V320"/><path class="map-path" d="M20 160H125L170 115H235L280 160H380M200 20V90M200 230V300M70 60L120 110M280 210L330 260"/><path class="shield" d="M200 68L270 94V155C270 206 200 246 200 246S130 206 130 155V94Z"/><path class="shield-inner" d="M200 92L247 110V155C247 187 200 220 200 220S153 187 153 155V110Z"/><path class="shield-check" d="M178 155L194 171L225 136"/><g class="map-nodes"><circle cx="20" cy="160" r="4"/><circle cx="380" cy="160" r="4"/><circle cx="200" cy="20" r="4"/><circle cx="200" cy="300" r="4"/><circle cx="70" cy="60" r="4"/><circle cx="330" cy="260" r="4"/></g></svg>
          <span class="map-label map-label-top">DETECT / INVESTIGATE</span><span class="map-label map-label-bottom">BUILD / DEFEND</span>
        </div>
        <div class="aside-line"><span class="status-dot" aria-hidden="true"></span><span>{identity.current}</span></div>
        <div class="aside-bottom"><span>{identity.location}</span><a href={`https://github.com/${identity.social.github}`} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div>
      </aside>
    </header>
    <div class="focus-strip"><span>SOC & INCIDENT RESPONSE</span><span>AI / LLM SECURITY</span><span>OPEN-SOURCE TOOLING</span></div>
    <section id="work" class="work-section">
      <div class="section-heading"><h2>{tr ? 'Üzerinde çalıştıklarım' : 'Built to defend.'}</h2><span>{tr ? 'Güvenlik, kodla buluşuyor.' : 'Security thinking, working code.'}</span></div>
      <div class="featured-work">{projects.slice(0,2).map((p,i) => <article class={`work-feature work-feature-${i}`} data-reveal>
        <div class="project-art" aria-label={tr ? 'Proje mimarisi' : 'Project architecture'}>
          <span class="art-caption">{i === 0 ? 'LLM SECURITY PROXY' : 'MCP SECURITY SCANNER'}</span>
          {i === 0 ? <div class="proxy-diagram"><span>request</span><span class="diagram-line" aria-hidden="true"></span><strong>TAMGA</strong><span class="diagram-line" aria-hidden="true"></span><span>LLM</span></div> : <div class="radar-diagram"><code>tools/list</code><div><span>SCHEMA</span><span>PAYLOAD</span><span>PERMISSIONS</span></div><code>mcpradar scan</code></div>}
          <span class="art-foot">{i === 0 ? 'PII REDACTION / INJECTION DEFENSE' : 'INSPECT / DETECT / REPORT'}</span>
        </div>
        <div class="project-details"><div class="project-title-row"><h3><a href={p.url} target="_blank" rel="noopener noreferrer">{short(p.name)} <span aria-hidden="true">↗</span></a></h3><span class="project-kind">{tr ? 'Açık kaynak' : 'Open source'}</span></div><p>{p.summary}</p><div class="project-tags">{p.tags.map(tag => <span>{tag}</span>)}</div></div>
      </article>)}</div>
      <div class="more-work">{projects.slice(2).map(p => <article class="project-row" data-reveal><h3>{p.url ? <a href={p.url} target="_blank" rel="noopener noreferrer">{short(p.name)} ↗</a> : short(p.name)}</h3><div><p>{p.summary}</p><div class="project-tags">{p.tags.map(tag => <span>{tag}</span>)}</div>{p.demo_url && <a class="text-link" href={p.demo_url} target="_blank" rel="noopener noreferrer">{tr ? 'Demoyu aç' : 'Open demo'} ↗</a>}{p.owner_note && <small>{p.owner_note}</small>}</div></article>)}</div>
    </section>
    <section id="experience" class="experience-section">
      <div class="section-heading"><h2>{tr ? 'Sahada.' : 'In the field.'}</h2><span>{tr ? 'Güvenlik operasyonlarında deneyim' : 'Hands-on security operations'}</span></div>
      {experience.map(e => <article class="experience-row" data-reveal><div class="experience-when"><span>{e.start} / {e.end ?? t(locale,'cmd.experience.present')}</span>{e.active && <span class="current-label">{tr ? 'Şu anda' : 'Current'}</span>}</div><div><h3>{e.company}</h3><p class="experience-role">{e.title}{e.part_time ? ` · ${t(locale,'cmd.experience.part_time')}` : ''}</p><ul>{e.highlights.map(h => <li>{h}</li>)}</ul></div></article>)}
    </section>
    <section class="about-section" id="about"><div><h2>{tr ? 'Merakla başlayan.' : 'Curiosity, applied.'}</h2><p class="about-copy">{about}</p><div class="education-list">{education.map(e => <div><h3>{e.school}</h3><p>{e.degree} · {e.start} / {e.end}{e.expected ? ` (${t(locale,'cmd.education.expected')})` : ''}</p></div>)}</div></div><div class="skills-column"><h3>{tr ? 'Araçlar ve uzmanlık' : 'Tools & disciplines'}</h3>{(['cybersecurity','ai_security','infrastructure','compliance','tools'] as const).map(group => <div class="skill-group"><h4>{t(locale,`skill_groups.${group}`)}</h4><p>{skills[group].join(' · ')}</p></div>)}<div class="spoken-languages">{skills.spoken_languages.map(l => <span>{l.name} / {l.level}</span>)}</div></div></section>
    <section class="credentials-section"><h2>{t(locale,'sections.certifications')}</h2><div class="credentials">{certifications.map(c => <div><h3>{c.name}</h3>{c.full_name && <p>{c.full_name}</p>}<span>{c.issuer}{c.date ? ` · ${c.date}` : ''}</span></div>)}</div></section>
    <section class="writing-section"><div class="section-heading"><h2>{tr ? 'Saha notları.' : 'Field notes.'}</h2><a class="text-link" href={`${prefix}/writeups`}>{tr ? 'Tüm yazılar' : 'All writing'} ↗</a></div>{writeups.map(w => <a class="writing-row" data-reveal href={w.path || w.url} target={w.path ? undefined : '_blank'} rel={w.path ? undefined : 'noopener noreferrer'}><time>{w.date}</time><h3>{w.title}</h3><span aria-hidden="true">↗</span></a>)}</section>
    <section class="contact-section" id="contact"><h2>{tr ? 'İletişime geçelim.' : 'Let’s talk security.'}</h2><a class="contact-email" href={`mailto:${identity.email}`}>{identity.email} <span aria-hidden="true">↗</span></a><div class="contact-links"><a href={`https://linkedin.com/in/${identity.social.linkedin}`} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={`https://github.com/${identity.social.github}`} target="_blank" rel="noopener noreferrer">GitHub ↗</a><button data-copy-email={identity.email} data-success={tr ? 'Kopyalandı' : 'Copied'} data-error={tr ? 'Kopyalanamadı. E-posta bağlantısını kullan.' : 'Could not copy. Use the email link.'}>{tr ? 'E-postayı kopyala' : 'Copy email'}</button><span class="copy-status" role="status"></span></div></section>
    <footer class="portfolio-footer"><span>© {new Date().getFullYear()} {identity.name}</span><a href={`${prefix}/terminal`}>{tr ? 'Komut satırından bak' : 'Take the command line'} <span aria-hidden="true">&gt;_</span></a><a href="#cv">{tr ? 'Yukarı' : 'Back to top'} ↑</a></footer>
  </article>
</div>
<script>
  import { heroReveal, scrollReveal } from '@lib/motion';
  document.body.classList.add('cv-body');
  heroReveal();
  scrollReveal();
  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach(button => {
    button.addEventListener('click', async () => {
      const status = document.querySelector('.copy-status');
      try {
        await navigator.clipboard.writeText(button.dataset.copyEmail ?? '');
        if(status) status.textContent = button.dataset.success ?? 'Copied';
      } catch { if(status) status.textContent = button.dataset.error ?? 'Could not copy'; }
    });
  });
</script>
