---
import LanguageToggle from '@components/LanguageToggle.astro';
import ViewToggle from '@components/ViewToggle.astro';
import type { Locale } from '@ptypes/profile';

export interface Props {
  locale: Locale;
  showLanguage?: boolean;
}

const { locale, showLanguage = true } = Astro.props;
---

<div class="header-controls">
  {showLanguage && <LanguageToggle locale={locale} />}
  <ViewToggle locale={locale} />
</div>

<style>
  .header-controls {
    position: fixed;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-2);
  }

  @media (max-width: 640px) {
    .header-controls {
      top: var(--space-2);
      right: var(--space-2);
      gap: 6px;
    }
  }
</style>
