---
import type { Locale } from '@ptypes/profile';
import writeups from '@data/writeups.json';
import HandRule from './HandRule.astro';
import NotebookFooter from './NotebookFooter.astro';
import '@styles/notebook.css';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = locale === 'tr';
const localePrefix = tr ? '/tr' : '';

interface Writeup {
  title: string;
  url?: string;
  path?: string;
  date: string;
  lang: string;
  tags: string[];
  summary: string;
  summary_tr: string;
}

const items = writeups as Writeup[];

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://fscakmak.com';
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: tr ? 'Fatih Serdar Çakmak · Yazılar' : 'Fatih Serdar Çakmak · Writeups',
  url: `${site}${localePrefix}/writeups`,
  inLanguage: locale,
  author: {
    '@type': 'Person',
    name: 'Fatih Serdar Çakmak',
    url: site,
  },
  blogPost: items.map((w) => ({
    '@type': 'BlogPosting',
    headline: w.title,
    url: w.path ? `${site}${w.path}` : w.url,
    datePublished: `${w.date}-01`,
    inLanguage: w.lang,
    keywords: w.tags.join(', '),
    abstract: tr ? w.summary_tr : w.summary,
    author: { '@type': 'Person', name: 'Fatih Serdar Çakmak', url: site },
  })),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(blogSchema)} />

<article class="nb">
  <a class="nb-back" href={localePrefix || '/'}>← Fatih Serdar Çakmak</a>
  <h1 class="nb-page-title">{tr ? 'yazdıklarım' : 'writing'}</h1>
  <p class="nb-intro">
    {tr
      ? 'Detection engineering, zararlı analizi ve web güvenliği üzerine notlar. Eskiler Medium’da, yeniler burada.'
      : 'Notes on detection engineering, malware analysis, and web security. The older ones are on Medium, the newer ones live here.'}
  </p>

  <HandRule variant={1} />

  <ul class="nb-posts">
    {items.map((w) => (
      <li>
        <div class="nb-post-meta">
          <span>{w.date}</span>
          <span>{w.lang.toUpperCase()}</span>
          <span>{w.tags.join(' · ')}</span>
        </div>
        <h2 class="nb-post-title">
          {w.path
            ? <a href={w.path} lang={w.lang}>{w.title}</a>
            : <a href={w.url} lang={w.lang} target="_blank" rel="noopener noreferrer">{w.title} ↗</a>}
        </h2>
        <p class="nb-post-summary">{tr ? w.summary_tr : w.summary}</p>
      </li>
    ))}
  </ul>

  <p class="nb-after">
    <a href="https://medium.com/@fscakmak" target="_blank" rel="noopener noreferrer">{tr ? 'Medium’daki tüm yazılar' : 'everything on Medium'} ↗</a>
  </p>

  <NotebookFooter locale={locale} />
</article>
