---
export interface Props {
  variant?: 0 | 1 | 2;
}

const { variant = 0 } = Astro.props;
// Three slightly different wobbles so stacked dividers don't look stamped.
const paths = [
  'M3 8 C 70 4, 140 11, 210 7 S 350 4, 420 8 S 540 11, 597 6',
  'M2 6 C 90 9, 160 3, 250 7 S 400 10, 470 6 S 560 4, 598 8',
  'M4 7 C 60 10, 130 4, 200 8 S 330 5, 410 7 S 520 3, 596 9',
];
---

<svg class="nb-rule" viewBox="0 0 600 14" aria-hidden="true" focusable="false">
  <path d={paths[variant]} />
</svg>
