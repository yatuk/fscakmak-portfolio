---
import BaseLayout from '@layouts/BaseLayout.astro';
import HomeView from '@components/HomeView.astro';

const locale = 'en';
const title = 'Fatih Serdar Çakmak · SOC Analyst & AI/LLM Security | ITU CS';
const description =
  'SOC analyst intern at Fibabanka and CE student at ITU, building open-source AI/LLM security tooling (Tamga, MCPRadar). SIEM, SOAR, detection, MCP security. Istanbul.';

---
<BaseLayout title={title} description={description} locale={locale} themeColor="#1b1a17" alternates={{ en: '/', tr: '/tr' }}>
  <HomeView locale={locale} />
</BaseLayout>
