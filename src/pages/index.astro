---
import BaseLayout from '@layouts/BaseLayout.astro';

const title = 'Fatih Serdar Çakmak — SOC Analyst | ITU CS';
const description =
  'SOC Analyst at Fibabanka, Computer Engineering @ ITU. Banking SOC, SIEM/SOAR, MITRE ATT&CK. Defending the systems others depend on.';
---

<BaseLayout title={title} description={description} locale="en">
  <div class="boot">
    <h1>fscakmak.com</h1>
    <p>v2 scaffold online — terminal coming back online in the next steps.</p>
    <p class="hint">Step 0 ✓ — Astro + TS scaffolded.</p>
  </div>
</BaseLayout>

<style>
  .boot {
    max-width: 880px;
    width: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-window);
    position: relative;
    z-index: 1;
  }

  h1 {
    color: var(--color-link);
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
    text-shadow: var(--glow-accent);
  }

  p {
    color: var(--color-text);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-2);
  }

  .hint {
    color: var(--color-text-dim);
    font-size: var(--text-sm);
    margin-top: var(--space-4);
  }
</style>
