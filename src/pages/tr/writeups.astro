---
import BaseLayout from '@layouts/BaseLayout.astro';
import WriteupsView from '@components/WriteupsView.astro';

const locale = 'tr';
const title = 'Yazılar — Fatih Serdar Çakmak | Detection, Zararlı Analizi & Web Güvenliği';
const description =
  'Fatih Serdar Çakmak imzalı güvenlik yazıları: detection engineering (KQL/EDR kuralları), zararlı analizi ve web güvenliği (SQL injection, phishing).';
---

<BaseLayout title={title} description={description} locale={locale}>
  <WriteupsView locale={locale} />
</BaseLayout>
