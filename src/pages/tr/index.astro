---
import BaseLayout from '@layouts/BaseLayout.astro';

const title = 'Fatih Serdar Çakmak — SOC Analisti | İTÜ Bilgisayar Müh.';
const description =
  'Fibabanka SOC Analisti, İTÜ Bilgisayar Mühendisliği. Bankacılık SOC, SIEM/SOAR, MITRE ATT&CK. Başkalarının bağımlı olduğu sistemleri savun.';
---

<BaseLayout title={title} description={description} locale="tr">
  <div class="boot">
    <h1>fscakmak.com</h1>
    <p>v2 iskelesi ayakta — terminal sonraki adımlarda geri dönüyor.</p>
    <p class="hint">Adım 0 ✓ — Astro + TS kuruldu.</p>
  </div>
</BaseLayout>

<style>
  .boot {
    max-width: 880px;
    width: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-window);
    position: relative;
    z-index: 1;
  }

  h1 {
    color: var(--color-link);
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
    text-shadow: var(--glow-accent);
  }

  p {
    color: var(--color-text);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-2);
  }

  .hint {
    color: var(--color-text-dim);
    font-size: var(--text-sm);
    margin-top: var(--space-4);
  }
</style>
