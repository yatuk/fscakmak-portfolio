---
import BaseLayout from '@layouts/BaseLayout.astro';
import RecruiterView from '@components/RecruiterView.astro';

const locale = 'tr';
const title = 'Fatih Serdar Çakmak · SOC Analisti & AI/LLM Güvenliği | İTÜ Bilgisayar Müh.';
const description =
  "Fibabanka'da SOC Analist Stajyeri, İTÜ Bilgisayar Mühendisliği öğrencisi; açık kaynak AI/LLM güvenlik araçları geliştiriyor (Tamga, MCPRadar). SIEM, SOAR, detection, MCP güvenliği. İstanbul.";

---
<BaseLayout title={title} description={description} locale={locale} hideHeaderControls={true} alternates={{ en: '/', tr: '/tr' }}>
  <RecruiterView locale={locale} />
</BaseLayout>
