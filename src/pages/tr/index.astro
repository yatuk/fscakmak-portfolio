---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getProfile } from '@lib/profile';

const profile = getProfile('tr');
const { identity, about } = profile;

const title = 'Fatih Serdar Çakmak — SOC Analist Stajyeri | İTÜ Bilgisayar Müh.';
const description =
  "Fibabanka'da SOC Analist Stajyeri, İTÜ Bilgisayar Mühendisliği. SIEM, SOAR, EDR, MITRE ATT&CK. İstanbul, Türkiye.";
---

<BaseLayout title={title} description={description} locale="tr">
  <div class="boot">
    <header>
      <h1>{identity.name}</h1>
      <p class="role">{identity.role}</p>
      <p class="location">{identity.location} · {identity.sector}</p>
      <p class="current">{identity.current}</p>
    </header>

    <section class="about">
      <p>{about}</p>
    </section>

    <footer>
      <p class="hint">
        Adım 1 ✓ — içerik CV'ye birebir uyumlu, tipli JSON'dan geliyor.
        <a href="/">→ English</a>
      </p>
    </footer>
  </div>
</BaseLayout>

<style>
  .boot {
    max-width: 880px;
    width: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-window);
    position: relative;
    z-index: 1;
  }

  header h1 {
    color: var(--color-link);
    font-size: var(--text-xl);
    text-shadow: var(--glow-accent);
    margin-bottom: var(--space-2);
  }

  .role {
    color: var(--color-text);
    font-size: var(--text-md);
    margin-bottom: var(--space-1);
  }

  .location {
    color: var(--color-text-dim);
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
  }

  .current {
    color: var(--color-prompt);
    font-size: var(--text-base);
    margin-bottom: var(--space-5);
  }

  .about p {
    color: var(--color-text);
    line-height: var(--leading-relaxed);
    font-size: var(--text-base);
    padding-left: var(--space-3);
    border-left: 2px solid var(--color-link);
  }

  .hint {
    color: var(--color-text-dim);
    font-size: var(--text-sm);
    margin-top: var(--space-5);
  }

  .hint a {
    margin-left: var(--space-2);
  }
</style>
