---
import '@styles/globals.css';
import jbmLatin400 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import jbmLatin600 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-600-normal.woff2?url';
import HeaderControls from '@components/HeaderControls.astro';
import { t } from '@core/i18n';
import type { Locale } from '@ptypes/profile';

export interface Props {
  title: string;
  description: string;
  locale?: Locale;
  canonical?: string;
  ogImage?: string;
  hideHeaderControls?: boolean;
  metaRobots?: string;
}

const {
  title,
  description,
  locale = 'en',
  canonical,
  ogImage = '/og-image.png',
  hideHeaderControls = false,
  metaRobots,
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://fscakmak.com';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).toString();
const ogImageUrl = new URL(ogImage, site).toString();
const cfBeaconToken = import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang={locale} data-theme="tokyonight">
  <head>
    <!-- Console flag for the technically curious -->
    <script is:inline>
      console.log(
        '%c fscakmak.com %c',
        'background:#22d3ee;color:#0d0d0d;font-weight:700;padding:4px 8px;border-radius:3px 0 0 3px;font-family:monospace;font-size:13px',
        ''
      );
      console.log(
        '%c SOC_FLAG{y0u_ch3ck3d_th3_c0ns0l3} ',
        'color:#22d3ee;font-family:monospace;font-size:11px'
      );
      console.log(
        '%c → try the terminal: run  cat .secret/flag.txt ',
        'color:#6b7280;font-family:monospace;font-size:11px'
      );
    </script>

    <!-- No-flash theme init + mobile auto-switch. Runs before any
         CSS paints so neither theme nor route flickers. -->
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('fsc.theme');
          if (t && ['tokyonight', 'cyberpunk', 'matrix', 'catppuccin'].includes(t)) {
            document.documentElement.dataset.theme = t;
          }
        } catch {
          /* private mode — keep default */
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d0d0d" />
    {metaRobots && <meta name="robots" content={metaRobots} />}
    <meta name="generator" content={Astro.generator} />

    <!-- Primary mono font — used above the fold on every page -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href={jbmLatin400} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={jbmLatin600} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- hreflang — trailingSlash: 'never' in astro.config -->
    <link rel="alternate" hreflang="en" href={site} />
    <link rel="alternate" hreflang="tr" href={`${site}/tr`} />
    <link rel="alternate" hreflang="x-default" href={site} />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === 'tr' ? 'tr_TR' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />


    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- JSON-LD Person schema -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Fatih Serdar Çakmak',
      alternateName: ['Fatih Çakmak', 'fscakmak'],
      url: site,
      email: 'mailto:fscakmak@proton.me',
      worksFor: {
        '@type': 'Organization',
        name: 'Fibabanka',
      },
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'Istanbul Technical University',
      },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Istanbul',
        addressCountry: 'TR',
      },
      sameAs: [
        'https://linkedin.com/in/fatihserdar',
        'https://github.com/yatuk',
        'https://medium.com/@fscakmak',
      ],
      knowsAbout: [
        'Security Operations Center',
        'SIEM', 'SOAR', 'EDR',
        'MITRE ATT&CK',
        'Incident Response',
        'Threat Intelligence',
      ],
    })} />

    {cfBeaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
      />
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">{t(locale, 'site.skip_to_content')}</a>
    {!hideHeaderControls && <HeaderControls locale={locale} />}
    <main id="main">
      <slot />
    </main>
  </body>
</html>
