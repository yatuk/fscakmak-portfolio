---
import '@styles/globals.css';

export interface Props {
  title: string;
  description: string;
  locale?: 'en' | 'tr';
  canonical?: string;
  ogImage?: string;
}

const {
  title,
  description,
  locale = 'en',
  canonical,
  ogImage = '/og-image.png',
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://fscakmak.com';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).toString();
const ogImageUrl = new URL(ogImage, site).toString();
---

<!doctype html>
<html lang={locale} data-theme="tokyonight">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0e14" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- hreflang -->
    <link rel="alternate" hreflang="en" href={`${site}/`} />
    <link rel="alternate" hreflang="tr" href={`${site}/tr/`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/`} />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === 'tr' ? 'tr_TR' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- JSON-LD Person schema -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Fatih Serdar Çakmak',
      jobTitle: 'SOC Analyst',
      url: site,
      email: 'mailto:fscakmak@proton.me',
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'Istanbul Technical University',
      },
      worksFor: {
        '@type': 'Organization',
        name: 'Fibabanka',
      },
      sameAs: [
        'https://github.com/yatuk',
        'https://linkedin.com/in/fatihserdar',
        'https://x.com/fscakmak',
      ],
    })} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <main id="main">
      <slot />
    </main>
  </body>
</html>
