---
import '@styles/globals.css';
import HeaderControls from '@components/HeaderControls.astro';
import { t } from '@core/i18n';
import type { Locale } from '@ptypes/profile';

export interface Props {
  title: string;
  description: string;
  locale?: Locale;
  canonical?: string;
  ogImage?: string;
}

const {
  title,
  description,
  locale = 'en',
  canonical,
  ogImage = '/og-image.png',
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://fscakmak.com';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).toString();
const ogImageUrl = new URL(ogImage, site).toString();
const cfBeaconToken = import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang={locale} data-theme="tokyonight">
  <head>
    <!-- No-flash theme init + mobile auto-switch. Runs before any
         CSS paints so neither theme nor route flickers. -->
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('fsc.theme');
          if (t && ['tokyonight', 'cyberpunk', 'matrix', 'catppuccin'].includes(t)) {
            document.documentElement.dataset.theme = t;
          }
        } catch {
          /* private mode — keep default */
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d0d0d" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- hreflang — trailingSlash: 'never' in astro.config -->
    <link rel="alternate" hreflang="en" href={site} />
    <link rel="alternate" hreflang="tr" href={`${site}/tr`} />
    <link rel="alternate" hreflang="x-default" href={site} />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === 'tr' ? 'tr_TR' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts — Manrope for body text in recruiter view -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- JSON-LD Person schema -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Fatih Serdar Çakmak',
      jobTitle: 'SOC Analyst Intern',
      url: site,
      email: 'mailto:fscakmak@proton.me',
      worksFor: {
        '@type': 'Organization',
        name: 'Fibabanka',
      },
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'Istanbul Technical University',
      },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Istanbul',
        addressCountry: 'TR',
      },
      sameAs: [
        'https://github.com/yatuk',
        'https://linkedin.com/in/fatihserdar',
      ],
    })} />

    {cfBeaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
      />
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">{t(locale, 'site.skip_to_content')}</a>
    <HeaderControls locale={locale} />
    <main id="main">
      <slot />
    </main>
  </body>
</html>
