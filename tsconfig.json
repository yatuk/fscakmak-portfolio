{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@core/*": ["src/core/*"],
      "@commands/*": ["src/commands/*"],
      "@data/*": ["src/data/*"],
      "@styles/*": ["src/styles/*"],
      "@ptypes/*": ["src/types/*"],
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@lib/*": ["src/lib/*"]
    },
    "resolveJsonModule": true,
    "allowJs": false,
    "verbatimModuleSyntax": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", "legacy"]
}
